  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "@id": "{{ site.url }}{{ page.url }}#service",
        "name": {{ serviceName | dump | safe }},
        "serviceType": {{ serviceType | dump | safe }},
        "description": {{ description | dump | safe }},
        "url": "{{ site.url }}{{ page.url }}",
        "provider": { "@type": "HomeAndConstructionBusiness", "@id": "{{ site.url }}/#business", "name": "FGM RENOV", "telephone": "{{ site.phoneIntl }}", "url": "{{ site.url }}/" },
        "areaServed": [{% for c in (communes.all if useCommunes else site.areaServed) %}{ "@type": "City", "name": {{ c | dump | safe }} }{% if not loop.last %}, {% endif %}{% endfor %}]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ site.url }}/" },
          { "@type": "ListItem", "position": 2, "name": {{ crumb | dump | safe }}, "item": "{{ site.url }}{{ page.url }}" }
        ]
      }{% if faq %},
      {
        "@type": "FAQPage",
        "mainEntity": [{% for f in faq %}
          { "@type": "Question", "name": {{ f.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | dump | safe }} } }{% if not loop.last %},{% endif %}{% endfor %}
        ]
      }{% endif %}
    ]
  }
  </script>
