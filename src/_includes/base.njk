<script>
/* Barre d'appel masquée tant que la topbar (qui affiche déjà le numéro) est à l'écran :
   la photo du hero s'affiche en entier à l'arrivée, et le numéro reste toujours accessible.
   Script en ligne juste après la barre : il s'exécute avant l'affichage (pas de clignotement).
   Sans IntersectionObserver ou sans JS, la barre reste simplement visible. */
(function () {
  var bar = document.getElementById('mobileStick'), topbar = document.querySelector('.topbar');
  if (!bar || !topbar || !('IntersectionObserver' in window)) return;
  bar.classList.add('is-hidden');
  new IntersectionObserver(function (e) {
    bar.classList.toggle('is-hidden', e[0].isIntersecting);
  }).observe(topbar);
})();
</script>

