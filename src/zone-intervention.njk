{% extends "base.njk" %}
{% block head %}
{% include "service-schema.njk" %}
{% endblock %}
{% block main %}
{% include "page-hero.njk" %}

  <section class="page-section" aria-labelledby="communes-title">
    <div class="container">
      <header class="section-head">
        <p class="kicker">{{ communes.total }} communes</p>
        <h2 id="communes-title">À moins de 25&nbsp;km de Saint-Philbert-sur-Risle</h2>
        <hr>
      </header>
      <p class="page-note communes-note">Distances à vol d'oiseau depuis Saint-Philbert-sur-Risle. Les communes de plus de 2&nbsp;000 habitants sont en gras.</p>
{%- for b in communes.bands %}
      <div class="communes-band">
        <h3>{{ b.label }} <span>· {{ b.communes | length }} communes</span></h3>
        <ul class="communes-list">
{%- for c in b.communes %}
          <li>{% if c.grande %}<strong>{{ c.nom }}</strong>{% else %}{{ c.nom }}{% endif %} <small>{{ c.cp }}</small></li>
{%- endfor %}
        </ul>
      </div>
{%- endfor %}
    </div>
  </section>

  <section class="page-section alt" aria-labelledby="loin-title">
    <div class="container">
      <header class="section-head">
        <p class="kicker">Rénovation jusqu'à 50&nbsp;km</p>
        <h2 id="loin-title">Et aussi, pour vos chantiers de rénovation</h2>
        <hr>
      </header>
      <ul class="zone-list">
        <li>Rouen</li><li>Elbeuf</li><li>Grand-Couronne</li><li>Le Havre</li><li>Port-Jérôme-sur-Seine</li><li>Lillebonne</li><li>Honfleur</li><li>Lisieux</li><li>Le Neubourg</li><li>Beaumont-le-Roger</li>
      </ul>
      <p class="page-note">Dépannage rapide dans un rayon de 40&nbsp;km. Votre commune n'apparaît pas ? <a href="tel:{{ site.phoneIntl }}">Appelez-nous</a>, un déplacement reste possible sur devis.</p>
    </div>
  </section>

{% include "faq-list.njk" %}
{% include "related.njk" %}
{% include "cta.njk" %}
{% endblock %}
